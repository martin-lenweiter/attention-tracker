{
  "name": "time-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local AI screen-time tracker: Screenpipe capture -> Ollama labels -> SQLite -> MCP for Hermes",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sampler": "tsx src/sampler.ts",
    "mcp": "tsx src/mcp.ts",
    "idle-reporter": "tsx src/idle-reporter.ts",
    "regroup": "tsx src/regroup.ts",
    "backup": "tsx src/backup.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.8.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
